{
  "name": "@effect-mcp/client",
  "version": "0.0.1",
  "description": "Effect MCP Client",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:code && pnpm run build:types",
    "build:code": "tsup",
    "build:types": "rm -f tsconfig.tsbuildinfo && tsc --emitDeclarationOnly"
  },
  "keywords": [
    "effect",
    "mcp",
    "modelcontextprotocol"
  ],
  "author": "Garrett Hardin",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": {
        "@effect-mcp/dev": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "@effect-mcp/dev": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "dependencies": {
    "@effect-mcp/shared": "workspace:*",
    "@effect/platform": "^0.77.2"
  },
  "peerDependencies": {
    "effect": "^3.13.2",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "tsup": "^8.3.6"
  }
}
